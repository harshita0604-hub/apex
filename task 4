<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Harshita Portfolio + Projects</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
  body { line-height: 1.6; background: #f0f2f5; color: #333; }
  header { background: linear-gradient(90deg, #4CAF50, #2e7d32); color: white; padding: 20px 0; text-align: center; position: sticky; top: 0; z-index: 100; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
  header h1 { font-size: 2em; text-shadow: 1px 1px 2px rgba(0,0,0,0.3); }
  nav { display: flex; justify-content: center; flex-wrap: wrap; gap: 5px; margin-top: 10px; }
  nav button { color: white; background: #43a047; border: none; padding: 10px 18px; cursor: pointer; font-weight: bold; border-radius: 25px; transition: all 0.3s; }
  nav button:hover { background: #357a38; transform: scale(1.05); }
  nav button.active { background: #1b5e20; box-shadow: 0 4px 8px rgba(0,0,0,0.3); transform: scale(1.1); }
  section { padding: 50px 20px; display: none; opacity: 0; transform: translateY(20px); transition: all 0.5s ease; max-width: 1200px; margin: auto; }
  section.active { display: block; opacity: 1; transform: translateY(0); }
  h2 { text-align: center; margin-bottom: 30px; color: #2e7d32; text-shadow: 1px 1px 2px rgba(0,0,0,0.2); }
  p { text-align: center; font-size: 1.1em; margin-bottom: 20px; }
  .projects, .products { display: flex; flex-wrap: wrap; gap: 25px; justify-content: center; }
  .project-card, .product { border-radius: 15px; padding: 20px; width: 250px; background: white; box-shadow: 0 8px 15px rgba(0,0,0,0.1); transition: transform 0.3s, box-shadow 0.3s; }
  .project-card:hover, .product:hover { transform: translateY(-7px); box-shadow: 0 12px 20px rgba(0,0,0,0.2); }
  .project-card h3, .product h3 { margin-bottom: 10px; color: #1b5e20; }
  form { display: flex; flex-direction: column; max-width: 450px; margin: auto; }
  form input, form textarea { margin: 10px 0; padding: 12px; border-radius: 8px; border: 1px solid #ccc; font-size: 1em; }
  form button, button { background: #4CAF50; color: white; border: none; padding: 12px; cursor: pointer; border-radius: 25px; font-weight: bold; transition: all 0.3s; }
  form button:hover, button:hover { background: #357a38; transform: scale(1.05); }
  #todoApp, #productApp { max-width: 650px; margin: auto; }
  ul { list-style: none; margin-top: 20px; padding: 0; }
  li { padding: 12px; border: 1px solid #ccc; margin-bottom: 8px; display: flex; justify-content: space-between; border-radius: 8px; background: #fff; transition: all 0.3s; }
  li.completed { text-decoration: line-through; color: gray; opacity: 0.6; }
  label { display: block; margin: 15px 0 5px; font-weight: bold; }
  select { padding: 8px; border-radius: 8px; border: 1px solid #ccc; font-size: 1em; }
  @media (max-width: 768px) { .projects, .products { flex-direction: column; align-items: center; } }
</style>
</head>
<body>

<header>
  <h1>Harshita Behare</h1>
  <nav>
    <button class="tab-btn active" data-target="about">About</button>
    <button class="tab-btn" data-target="portfolio">Portfolio</button>
    <button class="tab-btn" data-target="todo">To-Do App</button>
    <button class="tab-btn" data-target="products">Product Listing</button>
    <button class="tab-btn" data-target="contact">Contact</button>
  </nav>
</header>

<section id="about" class="active">
  <h2>About Me</h2>
  <p>Front-end developer passionate about building interactive web projects using HTML, CSS, and JavaScript. Always aiming to create responsive and visually appealing applications.</p>
</section>

<section id="portfolio">
  <h2>Portfolio Projects</h2>
  <div class="projects">
    <div class="project-card"><h3>Portfolio Website</h3><p>Responsive multi-page portfolio website with HTML, CSS & JS.</p></div>
    <div class="project-card"><h3>To-Do App</h3><p>Interactive task tracker with local storage for persistence.</p></div>
    <div class="project-card"><h3>Product Listing Page</h3><p>Filter and sort products dynamically for better user experience.</p></div>
  </div>
</section>

<section id="todo">
  <h2>To-Do List App</h2>
  <div id="todoApp">
    <input type="text" id="taskInput" placeholder="Add new task">
    <button onclick="addTask()">Add Task</button>
    <ul id="taskList"></ul>
  </div>
</section>

<section id="products">
  <h2>Product Listing Page</h2>
  <label>Filter by category:</label>
  <select id="categoryFilter">
    <option value="all">All</option>
    <option value="electronics">Electronics</option>
    <option value="clothing">Clothing</option>
  </select>

  <label>Sort by:</label>
  <select id="sortOption">
    <option value="default">Default</option>
    <option value="price">Price</option>
    <option value="rating">Rating</option>
  </select>

  <div class="products" id="productContainer"></div>
</section>

<section id="contact">
  <h2>Contact Me</h2>
  <form id="contactForm">
    <input type="text" placeholder="Your Name" required>
    <input type="email" placeholder="Email" required>
    <textarea placeholder="Message" rows="5" required></textarea>
    <button type="submit">Send Message</button>
  </form>
</section>

<script>
// Tab functionality with animation
const tabs = document.querySelectorAll('.tab-btn');
const sections = document.querySelectorAll('section');

tabs.forEach(tab => {
  tab.addEventListener('click', () => {
    tabs.forEach(t => t.classList.remove('active'));
    tab.classList.add('active');
    const target = tab.dataset.target;
    sections.forEach(sec => {
      sec.classList.remove('active');
      if(sec.id === target) sec.classList.add('active');
    });
  });
});

// Contact form
document.getElementById('contactForm').addEventListener('submit', e => {
  e.preventDefault();
  alert('Message sent! Thank you.');
  e.target.reset();
});

// --- To-Do App Logic ---
const taskList = document.getElementById('taskList');
let tasks = JSON.parse(localStorage.getItem('tasks')) || [];

function renderTasks() {
  taskList.innerHTML = '';
  tasks.forEach((task,index) => {
    const li = document.createElement('li');
    li.className = task.completed ? 'completed' : '';
    li.innerHTML = `${task.text} <span><button onclick="toggleComplete(${index})">✔</button> <button onclick="deleteTask(${index})">✖</button></span>`;
    taskList.appendChild(li);
  });
}

function addTask() {
  const input = document.getElementById('taskInput');
  if(input.value.trim()==='') return;
  tasks.push({text:input.value.trim(), completed:false});
  input.value='';
  saveTasks();
  renderTasks();
}

function toggleComplete(index) { tasks[index].completed=!tasks[index].completed; saveTasks(); renderTasks(); }
function deleteTask(index) { tasks.splice(index,1); saveTasks(); renderTasks(); }
function saveTasks() { localStorage.setItem('tasks', JSON.stringify(tasks)); }
renderTasks();

// --- Product Listing Logic (Prices in INR) ---
const products = [
  { name: 'Laptop', category: 'electronics', price: 100000, rating: 4.5 },
  { name: 'Phone', category: 'electronics', price: 60000, rating: 4.7 },
  { name: 'T-Shirt', category: 'clothing', price: 1500, rating: 4.2 },
  { name: 'Jeans', category: 'clothing', price: 2500, rating: 4.3 },
];

const container = document.getElementById('productContainer');
const categoryFilter = document.getElementById('categoryFilter');
const sortOption = document.getElementById('sortOption');

function renderProducts() {
  let filtered = products.filter(p => categoryFilter.value==='all' || p.category===categoryFilter.value);
  if(sortOption.value==='price') filtered.sort((a,b)=>a.price-b.price);
  if(sortOption.value==='rating') filtered.sort((a,b)=>b.rating-a.rating);
  container.innerHTML='';
  filtered.forEach(p => {
    const div = document.createElement('div');
    div.className='product';
    div.innerHTML=`<h3>${p.name}</h3>
                   <p>Category: ${p.category}</p>
                   <p>Price: ₹${p.price.toLocaleString()}</p>
                   <p>Rating: ${p.rating}</p>`;
    container.appendChild(div);
  });
}

categoryFilter.addEventListener('change', renderProducts);
sortOption.addEventListener('change', renderProducts);
renderProducts();
</script>

</body>
</html>
